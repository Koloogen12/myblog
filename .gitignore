# Dependencies
node_modules/

# Build output — regenerated by `npm run build`, deployed via _deploy/deploy.sh
dist/
dist-ssr/
*.local

# Environment — real values stay out of the repo.
# Copy .env.example to .env and fill it in. The Supabase anon key is public by
# design (protected by row-level security), but keeping .env untracked avoids
# ever committing a service_role key here by accident.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / cache
coverage/
.vite/
.eslintcache

# Netlify CLI state — leftover from a deploy experiment, not used
.netlify/
