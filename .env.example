# Copy to .env and fill in. All VITE_* values are baked into the client bundle
# at build time, so ONLY put values here that are safe to be public.
# Never add a service_role key — it bypasses row-level security.

VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Anon key: public by design, protected by row-level security.
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Supabase is reached through a same-origin /supabase/* reverse proxy declared
# in nginx (see _deploy/nginx-dkochnev.conf), because Russian ISPs intermittently
# block *.supabase.co. Point this at the proxy, not at supabase.co directly.
VITE_SUPABASE_URL="https://dkochnev.com/supabase"

# Legacy MinIO storage — kept for older records only; new uploads go to Supabase.
VITE_MINIO_ENDPOINT=""
VITE_MINIO_BUCKET=""
